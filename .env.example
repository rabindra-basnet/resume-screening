# ============================================================================
# Application environment configuration (TalentPulse AI)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- General application settings -----------------------------------------
APP_NAME=talentpulse-ai
APP_ENV=production
DEBUG=false
APP_ORIGIN=https://ats.saastralabs.com

# ----- Observability / logging ----------------------------------------------
# Every feature's logs flow to stdout AND logs/{APP_ENV}.log (e.g.
# logs/development.log) via baked-in defaults — no env vars required.
# Sentry DSN for error tracking. Free Developer tier: 5k errors/mo, 90-day
# retention. Leave empty to keep pure stdout logging (no network calls).
SENTRY_DSN=
# Fraction of requests to capture performance traces (0.0 = off, 1.0 = all).
SENTRY_TRACES_SAMPLE_RATE=0.0

# ----- Google OAuth 2.0 Credentials ----------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=your-secure-fernet-or-random-secret-key

# ----- LLM Provider (system default) -----------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key

# ----- Database (PostgreSQL Production / Neon) ------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/resume?ssl=require
