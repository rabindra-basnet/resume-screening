# ============================================================================
# Application environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- General application settings -----------------------------------------
APP_NAME=agentic-resume-screening
APP_ENV=development
DEBUG=true

# ----- LLM Provider (OpenAI-compatible) -------------------------------------
# Primary provider: openai | anthropic | azure | custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-REPLACE_ME
# Base URL override for OpenAI-compatible endpoints (local proxies, vLLM, Ollama, etc.)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# ----- Fallback LLM provider (optional) -------------------------------------
# LLM_FALLBACK_MODEL=claude-sonnet-4-20250514
# LLM_FALLBACK_API_KEY=sk-ant-REPLACE_ME

# ----- Database -------------------------------------------------------------
# SQLite (development) — relative to project root
DATABASE_URL=sqlite:///./screening.db
# Neon PostgreSQL (production) — free tier
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/resume?sslmode=require
