# ============================================================================
# Application environment configuration (TalentPulse AI)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- General application settings -----------------------------------------
APP_NAME=talentpulse-ai
APP_ENV=production
DEBUG=false
APP_ORIGIN=https://ats.saastralabs.com

# ----- Observability / logging ----------------------------------------------
# Every feature's logs flow to stdout AND logs/{APP_ENV}.log (e.g.
# logs/development.log) via baked-in defaults — no env vars required.

# ----- Google OAuth 2.0 Credentials ----------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=your-secure-fernet-or-random-secret-key

# ----- LLM Provider (system default) -----------------------------------------
# llm_api_key defaults to "sk-dummy" so the OpenAI-compatible client constructs
# without error. Point LLM_API_BASE at a keyless OpenAI-compatible gateway for
# now; swap LLM_API_KEY for a real key on Vercel when moving to a paid provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-dummy
# LLM_API_BASE=https://your-openai-compatible-gateway/v1

# ----- Database (PostgreSQL Production / Neon) ------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/resume?ssl=require
