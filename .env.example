# ============================================================================
# Application environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ----- General application settings -----------------------------------------
APP_NAME=agentic-resume-screening
APP_ENV=development
DEBUG=true

# ----- LLM Provider (system default, used when no user BYOK configured) ------
# Primary provider: openai | anthropic | azure | custom
LLM_PROVIDER=openai
# OpenCode Zen free tier (no cost). Full list: https://opencode.ai/zen/v1/models
LLM_MODEL=laguna-s-2.1-free
# Base URL override for OpenAI-compatible endpoints (Zen, local proxies, vLLM, Ollama, etc.)
LLM_API_BASE=https://opencode.ai/zen/v1
# Zen free models generally work without a key. If prompted for auth, set it:
# LLM_API_KEY=opencode-REPLACE_ME
# LLM_MAX_TOKENS=2000
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# ----- Encryption (API keys vault) -------------------------------------------
# Fernet key used to encrypt/decrypt user-provided BYOK API keys.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, one is auto-generated and persisted to .env.local (dev only).
# In production you MUST set this explicitly.
# ENCRYPTION_KEY=

# ----- Database --------------------------------------------------------------
# PostgreSQL (production / Neon). Use the asyncpg driver and ssl=require.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/resume?ssl=require
# SQLite (local development only)
# DATABASE_URL=sqlite:///./screening.db

# ----- Migrations ------------------------------------------------------------
# Apply schema migrations (PostgreSQL):
#   uv run alembic upgrade head

# ----- AetherGate Gateway UI -------------------------------------------------
# Gateway routes are served at /gateway/providers, /gateway/routing, /gateway/vault
